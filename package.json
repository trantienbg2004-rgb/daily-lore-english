{
  "name": "dailyloreenglish",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "node scripts/build-reader-index.mjs && vite build",
    "build:index": "node scripts/build-reader-index.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --test scripts/test/*.test.mjs",
    "wiki:auto": "node scripts/wiki-auto.mjs",
    "wiki:audit": "node scripts/wiki-audit.mjs",
    "wiki:audit-images": "node scripts/audit_wiki_images.mjs",
    "wiki:queue": "node scripts/build_wiki_queue.mjs",
    "wiki:batch": "node scripts/publish_wiki_batch.mjs",
    "audit:dict": "node scripts/audit_missing_words.mjs"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
